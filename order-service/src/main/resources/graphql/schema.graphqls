type Query {
    "Fetch one order by id."
    order(id: ID!): Order
    "Newest first, optionally only one status. size is capped at 100."
    ordersByCustomer(customerId: String!, status: OrderStatus, page: Int = 0, size: Int = 20): [Order!]!
    "How many orders match (all of them, not just one page): lets a client know where the last page is."
    orderCountByCustomer(customerId: String!, status: OrderStatus): Int!
}

type Mutation {
    "Prices every line from the catalog; the saga then confirms or cancels asynchronously."
    placeOrder(input: PlaceOrderInput!): Order!
    "Starts a refund. Only CONFIRMED orders can be cancelled."
    cancelOrder(id: ID!, reason: String): Order!
}

type Subscription {
    "Current status immediately, then every change; completes when the order reaches CONFIRMED or CANCELLED."
    orderStatusChanged(id: ID!): OrderStatusUpdate!
}

input PlaceOrderInput {
    customerId: String!
    items: [OrderLineInput!]!
}

input OrderLineInput {
    sku: String!
    quantity: Int!
}

type Order {
    id: ID!
    customerId: String!
    status: OrderStatus!
    totalAmount: Float!
    cancelReason: String
    createdAt: String!
    items: [OrderItem!]!
    "Null until the parcel has left the warehouse."
    fulfillment: Fulfillment
    carrier: String
    trackingNumber: String
}

enum Fulfillment {
    SHIPPED
    DELIVERED
}

type OrderItem {
    sku: String!
    quantity: Int!
    unitPrice: Float!
}

type OrderStatusUpdate {
    id: ID!
    status: OrderStatus!
    cancelReason: String
}

enum OrderStatus {
    PENDING
    INVENTORY_RESERVED
    CONFIRMED
    REFUND_PENDING
    CANCELLED
}
