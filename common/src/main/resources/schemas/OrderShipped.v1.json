{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/OrderShipped.v1.json",
  "title": "OrderShipped",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "carrier": {
      "type": "string"
    },
    "trackingNumber": {
      "type": "string"
    }
  },
  "required": [
    "eventId",
    "orderId",
    "occurredAt",
    "carrier",
    "trackingNumber"
  ]
}
