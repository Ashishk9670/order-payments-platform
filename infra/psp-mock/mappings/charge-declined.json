{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/charges",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.amount >= 20000)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "status": "declined",
      "reason": "Card declined by issuer"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
