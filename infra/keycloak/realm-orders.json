        "name": "customer"
      },
      {
        "name": "admin"
      },
      {
        "name": "service"
      }
    ]
  },
  "clients": [
    {
      "clientId": "storefront",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
