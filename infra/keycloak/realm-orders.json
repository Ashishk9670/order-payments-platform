        "customer"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "bob-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "ops",
      "enabled": true,
      "email": "ops@example.test",
